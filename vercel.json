{
  "version": 2,
  "installCommand": "npm install -g pnpm && pnpm install",
  "buildCommand": "NODE_ENV=production pnpm --filter @workspace/api-server run build && NODE_ENV=production pnpm --filter @workspace/dashboard run build",
  "outputDirectory": "artifacts/dashboard/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "api/*.cjs"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
